# ============================================
# Git line endings
# ============================================

# Automatically detect text files
* text=auto

# ============================================
# Unity YAML files
# ============================================

*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf

# ============================================
# Unity configuration
# ============================================

*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# ============================================
# C# scripts
# ============================================

*.cs text eol=lf

# ============================================
# Shader files
# ============================================

*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf

# ============================================
# Web files
# ============================================

*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf

# ============================================
# Markdown / documentation
# ============================================

*.md text eol=lf

# ============================================
# Shell scripts
# ============================================

*.sh text eol=lf

# ============================================
# Windows scripts
# ============================================

*.bat text eol=crlf
*.cmd text eol=crlf

# ============================================
# Binary files
# ============================================

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.tif binary
*.tiff binary
*.psd binary

*.fbx binary
*.obj binary
*.blend binary
*.dae binary
*.3ds binary

*.mp3 binary
*.wav binary
*.ogg binary
*.aiff binary

*.mp4 binary
*.mov binary
*.avi binary

*.ttf binary
*.otf binary

*.dll binary
*.so binary
*.aar binary
*.jar binary

*.zip binary
*.7z binary
*.rar binary

# ============================================
# Unity packages
# ============================================

*.unitypackage binary

# ============================================
# Microsoft Visual Studio
# ============================================

*.sln text eol=crlf
*.csproj text eol=crlf
*.vcxproj text eol=crlf